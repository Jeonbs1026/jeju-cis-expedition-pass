# 수정 전 백업 (각 1.5MB, 재현은 빌드/ 스크립트로)
빌드/*.html
*.bak
# Word 임시 파일
~$*
# 배포용 사본(JEJU_CIS_최종.html과 같은 파일)과 wrangler 캐시
배포/public/
배포/.wrangler/
.wrangler/
node_modules/
.DS_Store
# PDF는 Word에서 최종 내보낸 뒤 추가
*.pdf
!빌드/video_template.html
# 발표 대본은 개인 보관
발표대본.md
# 발표 덱은 대본(발표 메모)을 담고 있어 개인 보관
JEJU_CIS_최종발표.html
